{
  "name": "@k3i/ds",
  "version": "0.1.0",
  "description": "Figma 디자인 시스템 → 토큰(CSS 변수) → Lit 웹 컴포넌트 → React 래퍼",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/index.js"
    },
    "./react": {
      "types": "./dist/types/react/index.d.ts",
      "import": "./dist/react.js"
    },
    "./tokens.css": "./dist/tokens.css"
  },
  "files": [
    "dist"
  ],
  "sideEffects": [
    "./dist/index.js",
    "./dist/tokens.css"
  ],
  "scripts": {
    "tokens": "node scripts/build-tokens.mjs",
    "dev": "npm run tokens && vite",
    "build": "npm run tokens && vite build && tsc -p tsconfig.build.json",
    "preview": "vite preview",
    "figma:plugin": "node scripts/build-figma-plugin.mjs",
    "figma:connect": "figma connect publish"
  },
  "dependencies": {
    "lit": "^3.2.0"
  },
  "peerDependencies": {
    "@lit/react": "^1.0.0",
    "react": ">=17"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "@lit/react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@lit/react": "^1.0.6",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.7",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "style-dictionary": "^4.3.0",
    "typescript": "^5.6.0",
    "vite": "^5.4.0"
  }
}
