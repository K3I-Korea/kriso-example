{
  "$description": "Token 층. 색은 OpenBridge 변수(ob)를 가리키고, 필요할 때만 팔레트별(palettes) 덮어쓰기를 둔다. 직접 HEX 를 쓰는 것은 OpenBridge 에 대응 변수가 없을 때만 허용한다.",
  "color": {
    "surface":         { "ob": "--container-background-color" },
    "surface-section": { "ob": "--container-section-color" },
    "backdrop":        { "ob": "--container-backdrop-color" },
    "text":            { "ob": "--element-active-color" },
    "text-muted":      { "ob": "--element-neutral-color" },
    "accent":          { "ob": "--element-active-enhanced-color" },
    "border":          { "ob": "--border-outline-color" },
    "divider":         { "ob": "--border-divider-color" },
    "neutral":         { "ob": "--element-inactive-color" },
    "alarm":           { "ob": "--alert-alarm-color" },
    "warning":         { "ob": "--alert-warning-color" },
    "caution":         { "ob": "--alert-caution-color" },
    "manual":          { "ob": "--element-active-enhanced-color", "$description": "OpenBridge 에 수동 상태 전용 변수가 없어 강조색을 사용" }
  },
  "radius": {
    "md": { "ob": "--border-radius-br-8" },
    "lg": { "ob": "--border-radius-br-12" }
  },
  "space": {
    "1": { "value": "4px" },
    "2": { "value": "8px" },
    "3": { "value": "12px" },
    "4": { "value": "16px" },
    "6": { "value": "24px" }
  },
  "stroke": {
    "state": { "value": "2px", "$description": "상태 테두리 두께" },
    "manual-bar": { "value": "4px" }
  },
  "font": {
    "family": { "value": "'Noto Sans', sans-serif" },
    "label":  { "value": "600 13px/18px 'Noto Sans', sans-serif" },
    "title":  { "value": "600 16px/24px 'Noto Sans', sans-serif" },
    "badge":  { "value": "600 11px/16px 'Noto Sans', sans-serif" }
  }
}
