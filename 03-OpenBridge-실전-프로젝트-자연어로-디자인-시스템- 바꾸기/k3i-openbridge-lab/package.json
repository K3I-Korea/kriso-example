{
  "name": "k3i-openbridge-lab",
  "version": "0.1.0",
  "private": true,
  "description": "심화 실습: OpenBridge(L0) 위에 K3I 디자인 시스템(L1·L2)을 얹고 React 대시보드(L3)로 구현",
  "type": "module",
  "scripts": {
    "setup:font": "node scripts/copy-font.mjs",
    "tokens": "node scripts/build-tokens.mjs",
    "check": "node scripts/validate.mjs",
    "ob:vars": "node scripts/list-ob-vars.mjs",
    "predev": "npm run setup:font && npm run check && npm run tokens",
    "dev": "vite",
    "prebuild": "npm run setup:font && npm run check && npm run tokens",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@lit/react": "^1.0.8",
    "@oicl/openbridge-webcomponents": "2.1.0",
    "@oicl/openbridge-webcomponents-react": "2.1.0",
    "lit": "^3.3.3",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "typescript": "^5.6.0",
    "vite": "^5.4.0"
  }
}
