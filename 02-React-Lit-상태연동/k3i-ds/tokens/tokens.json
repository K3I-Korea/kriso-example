{
  "color": {
    "$type": "color",
    "brand": {
      "50":  { "$value": "#edf2ff" },
      "300": { "$value": "#91a7ff" },
      "500": { "$value": "#4c6ef5" },
      "600": { "$value": "#3b5bdb" },
      "700": { "$value": "#364fc7" }
    },
    "gray": {
      "0":   { "$value": "#ffffff" },
      "50":  { "$value": "#f8f9fa" },
      "200": { "$value": "#e9ecef" },
      "400": { "$value": "#adb5bd" },
      "600": { "$value": "#495057" },
      "800": { "$value": "#212529" },
      "900": { "$value": "#121417" }
    },
    "red": {
      "500": { "$value": "#e03131" }
    }
  },
  "semantic": {
    "$type": "color",
    "primary":      { "$value": "{color.brand.600}" },
    "primary-hover":{ "$value": "{color.brand.700}" },
    "on-primary":   { "$value": "{color.gray.0}" },
    "surface":      { "$value": "{color.gray.0}" },
    "surface-alt":  { "$value": "{color.gray.50}" },
    "border":       { "$value": "{color.gray.200}" },
    "text":         { "$value": "{color.gray.800}" },
    "text-muted":   { "$value": "{color.gray.600}" },
    "danger":       { "$value": "{color.red.500}" },
    "focus-ring":   { "$value": "{color.brand.300}" }
  },
  "space": {
    "$type": "dimension",
    "1": { "$value": "4px" },
    "2": { "$value": "8px" },
    "3": { "$value": "12px" },
    "4": { "$value": "16px" },
    "6": { "$value": "24px" }
  },
  "radius": {
    "$type": "dimension",
    "sm": { "$value": "4px" },
    "md": { "$value": "8px" },
    "lg": { "$value": "12px" }
  },
  "font": {
    "family": {
      "$type": "fontFamily",
      "base": { "$value": "Pretendard, -apple-system, 'Noto Sans KR', sans-serif" }
    },
    "label": { "$type": "font", "$value": "600 14px/20px {font.family.base}" },
    "body":  { "$type": "font", "$value": "400 14px/22px {font.family.base}" },
    "title": { "$type": "font", "$value": "700 18px/26px {font.family.base}" }
  },
  "shadow": {
    "$type": "shadow",
    "card": { "$value": "0 1px 3px rgba(0,0,0,.08), 0 4px 12px rgba(0,0,0,.06)" }
  }
}
